+import assert from 'node:assert/strict';
+// Import the real panel before installing a minimal DOM. This checks event and
+// repaint behavior; browser layout remains the separate smoke-aria-core test.
+const {mountCore}=await import('../js/console/panels/aria-core.js');
+const {ariaMind,resetMind,decideMind,startGoal,syncGoal,remember}=await import('../js/aria/mind.js');
+const {sim}=await import('../js/sim/sim.js');
+const {conversation}=await import('../js/aria/conversation.js');
+class Element {
+  constructor(tag){this.tag=tag;this.children=[];this.attrs={};this.style={};this.events={};this._text='';}
+  set textContent(s){this._text=String(s);this.children=[];}
+  get textContent(){return this._text+this.children.map(c=>c.textContent).join('');}
+  setAttribute(k,v){this.attrs[k]=v;}
+  append(...kids){this.children.push(...kids);}
+  replaceChildren(...kids){this._text='';this.children=kids;}
+  addEventListener(k,fn){this.events[k]=fn;}
+  focus(){}
+}
+globalThis.document={createElement:tag=>new Element(tag),createTextNode:text=>{const e=new Element('#text');e.textContent=text;return e;}};
+globalThis.localStorage={setItem(){}};
+globalThis.fetch=async()=>({ok:false,status:503});
+resetMind('panel');sim.time=1;
+decideMind({action:'mine',why:'ore nearby',steps:['MINE','DOCK'],at:1});startGoal('mine',{steps:['MINE','DOCK'],at:1});
+const root=new Element('root'),view=mountCore(root);
+const all=(e=root)=>[e,...e.children.flatMap(c=>all(c))];
+const question=all().find(e=>e.attrs['aria-label']==='Question for ARIA');
+question.value='Unsaved draft';
+syncGoal({source:'player',steps:['MINE','DOCK'],step:1,at:2});view.draw();assert.match(root.textContent,/2 \/ 2 · DOCK/);assert.equal(question.value,'Unsaved draft');
+remember({at:3,summary:'New observation'});view.draw();assert.match(root.textContent,/New observation/);
+const hiring=all().find(e=>e.attrs['aria-label']==='hiring authority');hiring.checked=false;hiring.events.change();assert.equal(ariaMind.authority.hiring,false);
+const ask=all().find(e=>e.tag==='button'&&e.textContent==='ASK ARIA');question.value='Why?';await ask.events.click();assert.match(root.textContent,/answered from the ship log/);assert.match(root.textContent,/Current goal: mine/);assert.equal(conversation.busy,false);
+globalThis.fetch=async()=>({ok:true,json:async()=>({text:'<img onerror=bad>'})});question.value='Why?';await ask.events.click();assert.match(root.textContent,/<img onerror=bad>/);assert.equal(all().some(e=>e.tag==='img'),false);
+view.dispose();
+console.log('aria-core-panel: live rendering, draft preservation, authority controls, fallback and text-only output PASS');
