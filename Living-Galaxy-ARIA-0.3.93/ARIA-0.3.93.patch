diff --git a/js/aria/conversation.js b/js/aria/conversation.js
new file mode 100644
index 0000000..659eee5
--- /dev/null
+++ b/js/aria/conversation.js
@@ -0,0 +1,56 @@
+import { ariaMind, explanationPacket, knownFacts } from './mind.js';
+export const conversation = { busy: false, lines: [], status: 'Ready', revision: 0 };
+let request = null, generation = 0;
+const clean = (s, n) => String(s ?? '').replace(/[\u0000-\u0008\u000b-\u001f]/g, '').slice(0, n);
+export function resetConversation() {
+  generation++; request?.abort(); request = null;
+  conversation.busy = false; conversation.lines = []; conversation.status = 'Ready'; conversation.revision++;
+}
+export function cancelConversation() {
+  generation++; request?.abort(); request = null;
+  conversation.busy = false; conversation.status = 'Cancelled'; conversation.revision++;
+}
+export function dialoguePacket(at = 0) {
+  const packet = explanationPacket();
+  const d = packet.decision;
+  return {
+    goal: clean(packet.activity?.action ?? d?.action ?? 'observe', 48),
+    step: clean(packet.activity?.steps?.[packet.activity.step] ?? 'observe', 48),
+    status: clean(packet.activity?.status ?? 'observing', 24),
+    reason: clean(packet.activity?.why || d?.why || 'No autonomous plan selected yet.', 180),
+    confidence: d?.confidence ?? 0,
+    state: d?.state ?? null,
+    orders: { mode: packet.orders.mode, reserve: packet.orders.reserve, repairBelow: packet.orders.repairBelow },
+    memories: packet.memories.slice(-2).map(e => clean(e.summary, 120)),
+    facts: knownFacts(at).slice(-2).map(f => ({ knowledge: f.knowledge, name: clean(f.data?.name ?? f.id, 50), detail: clean((f.data?.aboard === false ? 'No longer aboard' : f.data?.role) ?? (typeof f.data?.repair === 'boolean' ? `Repairs ${f.data.repair ? 'available' : 'unavailable'} when visited` : ''), 60), observedAt: f.observedAt })),
+  };
+}
+export function localReply(question, packet) {
+  if (/remember|crew|people|met/i.test(question)) return packet.memories.length ? `From the ship's log: ${packet.memories.join('. ')}` : 'I have no relevant encounters recorded yet.';
+  if (/confiden|certain|sure/i.test(question)) return `My confidence estimate is ${Math.round(packet.confidence * 100)}%. It reflects comparable observations and job outcomes; it is not a guarantee.`;
+  return `Current goal: ${packet.goal}. ${packet.reason}${packet.step !== 'observe' ? ` Current step: ${packet.step}.` : ''}`;
+}
+export async function askAria(question, { at = 0, fetchImpl = globalThis.fetch } = {}) {
+  if (conversation.busy) return null;
+  const q = clean(question, 240).trim(); if (!q) return null;
+  const packet = dialoguePacket(at), token = ++generation, identity = ariaMind.identity;
+  conversation.busy = true; conversation.status = 'ARIA is answering'; conversation.lines.push({ who: 'Captain', text: q });
+  conversation.lines = conversation.lines.slice(-15); conversation.revision++;
+  const controller = new AbortController(); request = controller;
+  const timer = setTimeout(() => controller.abort(), 45000);
+  let text, source = 'LFM2', reason = '';
+  try {
+    const response = await fetchImpl('/llm/proxy', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ aria: true, question: q, context: packet }), signal: controller.signal });
+    if (!response.ok) throw new Error(response.status === 429 ? 'Model busy' : response.status === 503 ? 'Model offline' : 'Model unavailable');
+    const result = await response.json();
+    if (typeof result.text !== 'string' || !result.text.trim()) throw new Error('No model reply');
+    text = clean(result.text, 1200); // Text is displayed with textContent; never evaluated or sent to an executor.
+  } catch (error) {
+    source = 'Ship log'; reason = error.name === 'AbortError' ? 'Model timed out' : clean(error.message, 60);
+    text = localReply(q, packet);
+  } finally { clearTimeout(timer); }
+  if (token !== generation || identity !== ariaMind.identity) return null;
+  request = null; conversation.busy = false; conversation.status = reason ? `${reason} — answered from the ship log` : 'Ready';
+  const line = { who: 'ARIA', text, source }; conversation.lines.push(line); conversation.lines = conversation.lines.slice(-16); conversation.revision++;
+  return line;
+}
