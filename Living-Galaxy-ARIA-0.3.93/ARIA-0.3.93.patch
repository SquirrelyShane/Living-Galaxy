--- /dev/null
+++ b/test/aria-relay.test.py
@@ -0,0 +1,80 @@
+"""Real HTTP relay tests against a fake local Ollama; no model download required."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import threading
+import urllib.error
+import urllib.request
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from unittest.mock import patch
+
+root = Path(__file__).resolve().parents[1]
+seen = []
+release = threading.Event()
+entered = threading.Event()
+mode = 'ok'
+
+class Model(BaseHTTPRequestHandler):
+    def log_message(self, *args): pass
+    def do_POST(self):
+        global mode
+        seen.append((self.path, json.loads(self.rfile.read(int(self.headers['Content-Length'])))))
+        entered.set()
+        if mode == 'wait': release.wait(5)
+        if mode == 'redirect':
+            self.send_response(302); self.send_header('Location', 'http://127.0.0.1:1/private'); self.end_headers(); return
+        body = b'x'*20000 if mode == 'large' else json.dumps({'message': {'content': 'Mining because ore is nearby.'}}).encode()
+        self.send_response(200); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(body))); self.end_headers(); self.wfile.write(body)
+
+with tempfile.TemporaryDirectory() as temp:
+    shutil.copy(root/'server.py', Path(temp)/'server.py')
+    with patch.object(sys, 'argv', ['server.py','0']):
+        spec=importlib.util.spec_from_file_location('aria_relay_test', Path(temp)/'server.py')
+        relay=importlib.util.module_from_spec(spec); spec.loader.exec_module(relay)
+    model=ThreadingHTTPServer(('127.0.0.1',0),Model)
+    http=ThreadingHTTPServer(('127.0.0.1',0),relay.Handler)
+    for server in (model,http): threading.Thread(target=server.serve_forever,daemon=True).start()
+    endpoint=f'http://127.0.0.1:{http.server_port}/llm/proxy'
+    body={'aria':True,'question':'Why this job?', 'context':{'goal':'mine','state':{'hull':.8}}, '_port':1,'_path':'/private','model':'attacker','options':{'num_ctx':99999}}
+    def post(data=body):
+        data=json.dumps(data).encode() if not isinstance(data,bytes) else data
+        req=urllib.request.Request(endpoint,data=data,headers={'Content-Type':'application/json'})
+        try:
+            with urllib.request.urlopen(req,timeout=10) as r:return r.status,json.loads(r.read())
+        except urllib.error.HTTPError as e:return e.code,json.loads(e.read())
+    def reset():relay.ARIA_DIALOGUE.last_at=-1e9
+    try:
+        with patch.dict(os.environ,{'LG_ARIA_ENABLED':'0'}): assert post()[0]==503
+        with patch.dict(os.environ,{'LG_ARIA_ENABLED':'1','LG_ARIA_PORT':str(model.server_port),'LG_ARIA_MODEL':relay.AriaDialogue.MODEL}):
+            assert post()[0]==200
+            path,payload=seen[-1]
+            assert path=='/api/chat';assert payload['model']==relay.AriaDialogue.MODEL
+            assert payload['options']['num_ctx']==2048 and payload['options']['num_predict']==160
+            assert payload['stream'] is False and payload['keep_alive']=='60s'
+            assert post()[0]==429,'global cooldown'
+            assert post(b'x'*9000)[0]==413
+            assert post(b'{')[0]==400
+            assert post([])[0]==400
+            assert post({'aria':True,'question':'','context':{}})[0]==400
+            assert post({'_port':11434,'prompt':'legacy unrestricted request'})[0]==400
+            reset();mode='wait';entered.clear();release.clear()
+            result=[];worker=threading.Thread(target=lambda:result.append(post()));worker.start();assert entered.wait(3)
+            assert post()[0]==429,'one inference globally across pilots'
+            release.set();worker.join();assert result[0][0]==200
+            reset();mode='large';assert post()[0]==502
+            reset();mode='redirect';assert post()[0]==502,'model redirects cannot reach other destinations'
+            reset();mode='ok';assert post()[0]==200,'failed requests release the lock'
+            huge={'aria':True,'question':'宇'*300,'context':{'goal':'宇'*300,'step':'宇'*300,'reason':'宇'*1000,'status':'宇'*300,'state':{'hull':float('nan'),'hz':float('inf'),'hold':999},'memories':['宇'*1000]*20,'facts':[{'name':'宇'*1000,'knowledge':'observed'}]*20}}
+            p=relay.ARIA_DIALOGUE.payload(huge)
+            assert len(p['messages'][1]['content'].encode())<1400
+            assert len(p['messages'])==2
+            reset();huge['question']='Why?';huge['context']={'state':{'hull':10**400},'confidence':10**400,'orders':{'reserve':10**400}}
+            assert post(huge)[0]==200,'huge JSON integers are clamped, not float-converted'
+    finally:
+        release.set()
+        for server in (http,model):server.shutdown();server.server_close()
+print('aria-relay: HTTP bounds, host-owned model/endpoint, cooldown, concurrency, redirects and recovery PASS')
