@@ -0,0 +1,34 @@
+import { sim } from '../sim/sim.js';
+import { crew } from '../crew/ledger.js';
+import { stationById } from '../station/stations.js';
+import { repairsAt, pricePerPoint } from '../flight/repair.js';
+import { ariaMind, observeFact, remember } from './mind.js';
+let lastAt = -Infinity, lastPort = null, people = new Set(), initialized = false;
+export function resetObservation() { lastAt = -Infinity; lastPort = null; people = new Set(); initialized = false; }
+export function observeCaptain() {
+  if (sim.phase !== 'play' || sim.time - lastAt < 5) return;
+  lastAt = sim.time;
+  const port = sim.ship?.dockedAt ?? null;
+  if (port && port !== lastPort) {
+    const st = stationById(port);
+    if (st) {
+      observeFact(`port:${st.id}`, { name: st.name, repair: repairsAt(st), repairPrice: repairsAt(st) ? pricePerPoint(st) : null, sector: st.sector }, sim.time, 600);
+      remember({ at: sim.time, kind: 'port', summary: `Docked at ${st.name}`, place: st.id, importance: 0.35 });
+    }
+  }
+  lastPort = port;
+  const next = new Set(crew.aboard.map(m => m.id));
+  for (const m of crew.aboard) {
+    if (!people.has(m.id)) {
+      observeFact(`person:${m.id}`, { personId: m.id, name: m.name, role: m.title, aboard: true, place: port ?? 'aboard' }, sim.time, 3600);
+      // Suppress duplicate events emitted by the autonomous business executor.
+      if (initialized && !ariaMind.episodes.some(e => e.kind === 'crew' && e.actors.includes(m.id) && Math.abs(e.at - sim.time) < 10)) remember({ at: sim.time, kind: 'crew', summary: `${m.name} joined the ship`, actors: [m.id], place: port, importance: 0.65 });
+    }
+  }
+  if (initialized) for (const id of people) if (!next.has(id)) {
+    const prior = ariaMind.facts.find(f => f.id === `person:${id}`);
+    observeFact(`person:${id}`, { ...prior?.data, personId: id, aboard: false, place: port }, sim.time, 3600);
+    remember({ at: sim.time, kind: 'crew', summary: `${prior?.data?.name ?? 'Crew member'} is no longer aboard`, actors: [id], place: port, importance: 0.65 });
+  }
+  people = next; initialized = true;
+}
