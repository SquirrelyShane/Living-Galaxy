+import assert from 'node:assert/strict';
+import { ariaMind, resetMind, learnTape, contextualScore, policyScore, setOrders, decideMind, learnOutcome, startGoal, suspendGoal, syncGoal, finishGoal, observeFact, knownFacts, remember, loadMind, saveMind } from '../js/aria/mind.js';
+const state = { hull: .9, hold: .2, chg: .8, hz: 0, dk: 0 };
+resetMind('test');
+const tape = (act, s = state, by = 'player') => learnTape({by, kind: 'mission', act, s, d: { cr: 100, dt: 30, hull: 0 }});
+for (let i=0;i<30;i++) tape('MINE');
+for (let i=0;i<30;i++) tape('DOCK'); // Docking alone is not a trading preference.
+assert.equal(contextualScore('board:mining', state).lean, 1, 'career and player actions share comparable habits');
+assert.equal(contextualScore('mine', {...state,hz:1}).samples, 0, 'safe habits do not masquerade as combat evidence');
+assert.equal(contextualScore('mine', {...state,dk:1}).samples, 0, 'docked actions are distinct');
+assert.equal(contextualScore('mine', {...state,hull:.1,hold:.9}).samples, 0, 'dissimilar hull/cargo observations excluded');
+for (let i=0;i<90;i++) tape('SALVAGE', state, 'aria');
+assert.equal(contextualScore('salvage',state).lean,0,'ARIA does not learn its own actions as captain habits');
+setOrders({mode:'imitate'});
+assert.ok(policyScore('board:mining',900,state)>policyScore('board:salvage',900,state)*1.4, 'captain habits affect career-sized scores');
+assert.equal(policyScore('mine',-Infinity,state),-Infinity,'learned habits cannot revive infeasible candidates');
+setOrders({mode:'directive'}); assert.equal(policyScore('mine',900,state),900);
+resetMind('test');
+const initialConfidence=decideMind({action:'salvage',state}).confidence;
+for(let i=0;i<20;i++) learnOutcome('salvage',60,-100,false,i);
+assert.ok(decideMind({action:'salvage',state}).confidence<initialConfidence,'an all-failure history lowers confidence below the untested baseline');
+for (let i=0;i<20;i++) learnOutcome('mine',60,100,true,i);
+const success = decideMind({action:'mine',state}).confidence;
+for (let i=0;i<60;i++) learnOutcome('mine',60,-100,false,30+i);
+assert.ok(decideMind({action:'mine',state}).confidence<success,'repeated failures lower confidence instead of increasing it');
+assert.ok(ariaMind.experience.moves.mine.predictionError>0,'surprising outcomes recorded');
+startGoal('mine',{source:'player',steps:['MINE','DOCK'],at:1});
+syncGoal({source:'player',step:1,steps:['MINE','DOCK'],at:2,state});
+assert.equal(ariaMind.goals.at(-1).goal,'DOCK');
+suspendGoal('damaged hull',3); assert.equal(ariaMind.suspended[0].action,'mine');
+startGoal('repair',{source:'player',steps:['DOCK','REPAIR'],at:4});
+finishGoal('done','repaired',5,'career'); assert.equal(ariaMind.activity.status,'running','other executor cannot finish current activity');
+finishGoal('done','repaired',5,'player');
+startGoal('mine',{source:'player',steps:['MINE','DOCK'],at:6}); assert.equal(ariaMind.suspended.length,0);
+observeFact('port:a',{name:'Visited'},10,20);
+assert.equal(knownFacts(20)[0].knowledge,'observed'); assert.equal(knownFacts(31)[0].knowledge,'stale'); assert.equal(knownFacts(0)[0].knowledge,'stale');
+for(let i=0;i<80;i++) observeFact(`port:${i}`,{name:String(i)},i);
+assert.equal(ariaMind.facts.length,64);
+remember({summary:'important encounter',importance:1,at:100});
+for(let i=0;i<130;i++) remember({summary:'routine',importance:.1,at:101+i});
+assert.equal(ariaMind.episodes.length,96); assert.ok(ariaMind.episodes.some(e=>e.summary==='important encounter'));
+const store=new Map(); globalThis.localStorage={getItem:k=>store.get(k),setItem:(k,v)=>store.set(k,v)};
+ariaMind.authority.hiring=false;saveMind('test');loadMind('test');
+assert.equal(ariaMind.authority.hiring,false);assert.equal(ariaMind.facts.length,64);assert.equal(ariaMind.activity,null,'old live goal is not restored as a running mission');
+store.set('v2',JSON.stringify({v:2,authority:{navigation:false},experience:{moves:{mine:{runs:2,secs:120,cr:200,fails:0}},runs:2,sky:'sol'}}));
+loadMind('v2');assert.equal(ariaMind.authority.navigation,false);assert.equal(ariaMind.experience.runs,2);
+console.log('aria-core-learning: contextual transfer, confidence, interruption, retention and v2 migration PASS');
