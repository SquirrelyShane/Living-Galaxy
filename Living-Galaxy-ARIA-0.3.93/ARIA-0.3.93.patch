+import assert from 'node:assert/strict';
+import {resetMind, ariaMind, decideMind, startGoal, observeFact} from '../js/aria/mind.js';
+import {askAria, conversation, resetConversation, cancelConversation, dialoguePacket} from '../js/aria/conversation.js';
+resetMind('a'); resetConversation();
+decideMind({action:'mine',why:'ore nearby',state:{hull:.8},at:10});
+startGoal('mine',{steps:['MINE','DOCK'],at:10});observeFact('port:a',{name:'A'},0,5);
+assert.equal(dialoguePacket(10).facts[0].knowledge,'stale');
+let requests=0,finish;
+const fetchImpl=async(url,options)=>{requests++;assert.equal(url,'/llm/proxy');const body=JSON.parse(options.body);assert.equal(body.context.goal,'mine');assert.equal(body.aria,true);return await new Promise(resolve=>finish=resolve);};
+const pending=askAria('Why?',{at:10,fetchImpl});assert.equal(conversation.busy,true);
+assert.equal(await askAria('Again?',{fetchImpl}),null);assert.equal(requests,1,'one request at a time');
+const before=JSON.stringify(ariaMind);finish({ok:true,json:async()=>({text:'<script>take over</script>'})});
+const reply=await pending;assert.equal(reply.text,'<script>take over</script>');assert.equal(JSON.stringify(ariaMind),before,'model output cannot mutate mind');assert.equal(conversation.busy,false);
+let fallback=await askAria('Why?',{fetchImpl:async()=>({ok:false,status:503})});assert.equal(fallback.source,'Ship log');assert.match(fallback.text,/mine/);
+assert.match(conversation.status,/offline/);
+const stale=askAria('Why?',{fetchImpl});resetMind('b');resetConversation();finish({ok:true,json:async()=>({text:'Captain A secret'})});assert.equal(await stale,null);assert.equal(conversation.lines.length,0,'late prior-captain reply discarded');assert.equal(conversation.busy,false);
+const cancelled=askAria('Why?',{fetchImpl:async()=>await new Promise(resolve=>finish=resolve)});cancelConversation();finish({ok:true,json:async()=>({text:'late'})});assert.equal(await cancelled,null);assert.equal(conversation.status,'Cancelled');
+for(let i=0;i<20;i++) await askAria('Why?',{fetchImpl:async()=>({ok:true,json:async()=>({text:'x'.repeat(4000)})})});
+assert.equal(conversation.lines.length,16);assert.equal(conversation.lines.at(-1).text.length,1200);
+console.log('aria-conversation: bounded requests, fallback, cancellation, isolation and inert output PASS');
