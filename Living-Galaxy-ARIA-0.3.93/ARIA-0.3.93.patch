+// node test/smoke-aria-core.mjs /absolute/playwright/index.mjs [port]
+// CHROME_BIN optionally selects a preinstalled Chromium. Start server.py first.
+import assert from 'node:assert/strict';
+const { chromium } = await import(process.argv[2]);
+const browser = await chromium.launch({ executablePath: process.env.CHROME_BIN || undefined, args: ['--no-sandbox', '--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader'] });
+const errors=[];
+try {
+  const page=await browser.newPage({viewport:{width:1280,height:960}});
+  page.on('pageerror',error=>errors.push(error.message));
+  await page.goto(`http://127.0.0.1:${process.argv[3] || 8124}/`,{waitUntil:'networkidle'});
+  // Launch through the public simulation API, then use the real console UI.
+  await page.evaluate(async()=>{
+    const {makePilot}=await import('/js/flight/pilot.js');
+    const {sim,launchSim}=await import('/js/sim/sim.js');
+    const {wireAria}=await import('/js/aria/aria.js');
+    wireAria(); makePilot('Core Smoke','terran','mining',null);launchSim('Core Smoke','sol');sim.phase='play';
+    document.querySelector('#start')?.classList.add('hidden');
+    const {resetMind,decideMind,startGoal,remember,observeFact}=await import('/js/aria/mind.js');
+    resetMind('smoke');decideMind({action:'mine',why:'Ore is close and the hold has room',steps:['MINE','DOCK'],state:{hull:.9},at:sim.time});startGoal('mine',{steps:['MINE','DOCK'],at:sim.time});
+    remember({summary:'A long but useful remembered encounter with the port watch',actors:[],at:sim.time});observeFact('port:smoke',{name:'Test Port',repair:true},sim.time);
+    const {openConsole}=await import('/js/console/console.js');openConsole('nav','core');
+  });
+  await page.getByRole('textbox',{name:'Question for ARIA'}).waitFor();
+  await page.getByRole('textbox',{name:'Question for ARIA'}).fill('Why are you mining?');
+  await page.getByRole('button',{name:'ASK ARIA',exact:true}).click();
+  await page.getByRole('status').filter({hasText:'answered from the ship log'}).waitFor();
+  assert.ok(await page.getByText('Current goal: mine.',{exact:false}).count());
+  await page.evaluate(async()=>{
+    const {syncGoal}=await import('/js/aria/mind.js');const {sim}=await import('/js/sim/sim.js');
+    syncGoal({source:'player',step:1,steps:['MINE','DOCK'],at:sim.time+1,status:'running'});
+  });
+  await page.getByText('2 / 2 · DOCK',{exact:true}).waitFor();
+  const input=page.getByRole('textbox',{name:'Question for ARIA'});
+  await input.fill('Draft stays while state updates');
+  await page.evaluate(async()=>{const {remember}=await import('/js/aria/mind.js');remember({summary:'A newly observed event'});});
+  await page.getByText('A newly observed event',{exact:true}).waitFor();
+  assert.equal(await input.inputValue(),'Draft stays while state updates');
+  await page.getByRole('checkbox',{name:'hiring authority',exact:true}).uncheck();
+  assert.equal(await page.evaluate(async()=>(await import('/js/aria/mind.js')).ariaMind.authority.hiring),false);
+  await page.screenshot({path:'/tmp/aria392-core-desktop.png'});
+  await page.setViewportSize({width:412,height:915});
+  await input.scrollIntoViewIfNeeded();
+  const fits=await page.evaluate(()=>{
+    const body=document.querySelector('.con-body');return {scroll:body.scrollWidth,width:body.clientWidth};
+  });
+  assert.ok(fits.scroll<=fits.width+2,`portrait overflow: ${JSON.stringify(fits)}`);
+  await page.screenshot({path:'/tmp/aria392-core-phone.png'});
+  // A model string must remain plain text, even when it resembles markup.
+  await page.route('**/llm/proxy',route=>route.fulfill({status:200,contentType:'application/json',body:JSON.stringify({text:'<img src=x onerror="window.ariaInjected=true">'})}));
+  await input.fill('Explain');await page.getByRole('button',{name:'ASK ARIA',exact:true}).click();
+  await page.getByText('<img src=x onerror="window.ariaInjected=true">',{exact:true}).waitFor();
+  assert.equal(await page.evaluate(()=>window.ariaInjected),undefined);
+  assert.deepEqual(errors,[]);
+  console.log('smoke-aria-core: desktop/phone, live steps and memory, draft preservation, authority, fallback and inert model text PASS');
+} finally {await browser.close();}
