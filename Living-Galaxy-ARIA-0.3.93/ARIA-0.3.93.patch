+#!/usr/bin/env bash
+# Run on the mini-PC after deploying the updated relay/server.py.
+set -euo pipefail
+[ "$(id -u)" = 0 ] || { echo 'Run with sudo.'; exit 1; }
+OLLAMA_BIN=$(command -v ollama || true)
+[ -n "$OLLAMA_BIN" ] || { echo 'Install Ollama from https://ollama.com/download/linux, then rerun.'; exit 1; }
+[ -f /srv/living-galaxy/relay/server.py ] && grep -q 'class AriaDialogue' /srv/living-galaxy/relay/server.py || { echo 'Deploy the updated relay/server.py first.'; exit 1; }
+systemctl cat lg-relay.service >/dev/null || { echo 'lg-relay.service is required.'; exit 1; }
+# A separate unprivileged service avoids modifying an existing Ollama instance.
+id lgaria >/dev/null 2>&1 || useradd --system --home-dir /var/lib/lg-aria --shell /usr/sbin/nologin lgaria
+install -d -o lgaria -g lgaria -m 750 /var/lib/lg-aria/models
+cat > /etc/systemd/system/lg-aria-model.service <<EOF
+[Unit]
+Description=Living Galaxy ARIA on-demand dialogue
+After=network.target
+
+[Service]
+User=lgaria
+Group=lgaria
+ExecStart=$OLLAMA_BIN serve
+WorkingDirectory=/var/lib/lg-aria
+Environment=OLLAMA_HOST=127.0.0.1:11435
+Environment=OLLAMA_MODELS=/var/lib/lg-aria/models
+Environment=OLLAMA_NUM_PARALLEL=1
+Environment=OLLAMA_MAX_LOADED_MODELS=1
+Environment=OLLAMA_MAX_QUEUE=1
+Environment=OLLAMA_KEEP_ALIVE=60s
+MemoryMax=2G
+CPUQuota=150%
+Nice=10
+NoNewPrivileges=true
+ProtectSystem=strict
+ProtectHome=true
+ReadWritePaths=/var/lib/lg-aria
+PrivateTmp=true
+Restart=on-failure
+RestartSec=5
+
+[Install]
+WantedBy=multi-user.target
+EOF
+systemctl daemon-reload
+systemctl enable --now lg-aria-model
+# Wait at most 15 seconds for the local listener before pulling the chosen model.
+ready=0
+for attempt in {1..15}; do
+  if OLLAMA_HOST=127.0.0.1:11435 "$OLLAMA_BIN" list >/dev/null 2>&1; then ready=1; break; fi
+  sleep 1
+done
+[ "$ready" = 1 ] || { echo 'ARIA model service did not start; inspect journalctl -u lg-aria-model.'; exit 1; }
+OLLAMA_HOST=127.0.0.1:11435 "$OLLAMA_BIN" pull hf.co/LiquidAI/LFM2-700M-GGUF:Q4_K_M
+# Enable inference only after the selected model was downloaded successfully.
+install -d /etc/systemd/system/lg-relay.service.d
+cat > /etc/systemd/system/lg-relay.service.d/aria.conf <<'EOF'
+[Service]
+Environment=LG_ARIA_ENABLED=1
+Environment=LG_ARIA_PORT=11435
+Environment=LG_ARIA_MODEL=hf.co/LiquidAI/LFM2-700M-GGUF:Q4_K_M
+EOF
+systemctl daemon-reload
+systemctl restart lg-relay
+systemctl --no-pager --full status lg-aria-model || true
+printf '%s\n' 'ARIA ready. In the game, open NAV > CORE and ask a question.' 'The relay restart also restarts a dependent lg-sol service; persistent Sol resumes its checkpoint.'
